{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with persistent credit balance and credentials.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user ID from Firebase Auth."
        },
        "name": {
          "type": "string",
          "description": "Display name of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user."
        },
        "credits": {
          "type": "integer",
          "description": "Current available credits of the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Time of registration."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity or update."
        }
      },
      "required": [
        "userId",
        "name",
        "email",
        "credits",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction representing credit purchase.",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "description": "Unique transaction ID."
        },
        "userId": {
          "type": "string",
          "description": "ID of the user buying credits."
        },
        "amount": {
          "type": "integer",
          "description": "Amount paid in Indonesian Rupiah (IDR)."
        },
        "creditsBought": {
          "type": "integer",
          "description": "Number of credits added."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "failed"],
          "description": "Status of the payment."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": [
        "transactionId",
        "userId",
        "amount",
        "creditsBought",
        "status",
        "createdAt"
      ]
    },
    "Usage": {
      "title": "Usage",
      "description": "A log entries tracking when applications are used and credits are consumed.",
      "type": "object",
      "properties": {
        "usageId": { "type": "string", "description": "Unique log ID." },
        "userId": {
          "type": "string",
          "description": "ID of the user who triggered the application."
        },
        "appId": {
          "type": "string",
          "description": "Slug/identifier of the application used."
        },
        "creditsSpent": {
          "type": "integer",
          "description": "Credits deducted (2 per use)."
        },
        "parameters": {
          "type": "object",
          "description": "Input parameters sent to the application."
        },
        "output": {
          "type": "string",
          "description": "Response output generated by the application."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Time the usage occurred."
        }
      },
      "required": ["usageId", "userId", "appId", "creditsSpent", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile collection holding individual credit balances."
    },
    "users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Credit purchases details under each specific user."
    },
    "users/{userId}/usages/{usageId}": {
      "schema": "Usage",
      "description": "Usage history for each user specifying executed apps."
    }
  }
}
