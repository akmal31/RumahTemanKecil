# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL Connection URL (e.g., postgresql://username:password@hostname:5432/database_name)
# Optional: If this variable is not set, the application will fallback to an in-memory database simulation for immediate preview testing.
DATABASE_URL="postgres://username:password@hostname:5432/dbname"

# GOOGLE_CLIENT_ID: Your Google Cloud Console OAuth Client Credentials ID
# Optional: If this is omit, the login system provides a visual mock simulator for authorization testing.
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Your Google Cloud Console OAuth Client Secret Key
# Optional: Associated with GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=""

# Meta Pixel & Conversions API Tracking
# Exposes the Pixel ID to the client-side tracking script (e.g. 1234567890)
NEXT_PUBLIC_META_PIXEL_ID=""
# Private server-side Access Token for Conversions API (CAPI) events
META_CONVERSIONS_API_ACCESS_TOKEN=""

# iPaymu Payment Gateway Integration (Optional: Fallbacks to mock modal if not set)
# Your iPaymu Virtual Account Number (VA)
IPAYMU_VA=""
# Your iPaymu API Secret Key
IPAYMU_API_KEY=""
# Set to "true" for Sandbox and "false" for Production, or use IPAYMU_ENV
IPAYMU_SANDBOX="true"
# Alternatively, set to "sandbox" / "staging" or "production" / "prod"
IPAYMU_ENV="sandbox"
