# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL Connection URL (e.g., postgresql://username:password@hostname:5432/database_name)
# Optional: If this variable is not set, the application will fallback to an in-memory database simulation for immediate preview testing.
DATABASE_URL="postgres://username:password@hostname:5432/dbname"

# GOOGLE_CLIENT_ID: Your Google Cloud Console OAuth Client Credentials ID
# Optional: If this is omit, the login system provides a visual mock simulator for authorization testing.
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Your Google Cloud Console OAuth Client Secret Key
# Optional: Associated with GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=""
